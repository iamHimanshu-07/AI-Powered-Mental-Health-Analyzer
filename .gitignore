__pycache__/
*.pyc
# *.pkl   -- tracked via .gitattributes (LFS); see re-enable below
*.model
*.h5
*.pt
*.joblib

.env
venv/
.venv/
myenv/

.ipynb_checkpoints/

# --------------------------------------------------------------------------- #
# Project-level ``models/`` (the metrics folder) is gitignored *except* for
# ``metrics.json`` which is small and powers the sidebar on Streamlit Cloud.
# We anchor with a leading slash so this does NOT also match ``app/models/``
# (which contains the LFS-tracked model artefacts — see below).
# --------------------------------------------------------------------------- #
/models/
notebooks/*.pkl

# But the small metrics.json *is* safe to commit (and is required for the
# sidebar to show F1/Precision/Recall on Streamlit Community Cloud, where
# the ``models/`` directory would otherwise be empty).
!/models/metrics.json

# --------------------------------------------------------------------------- #
# Model artefacts (mindpulse-ai/app/models/*.pkl)
# --------------------------------------------------------------------------- #
# These are large binaries and are tracked by Git LFS (see .gitattributes).
# Even though the bare ``*.pkl`` rule above is commented out, the ``models/``
# line still covers them — we re-enable only the ones we want in git below.
!app/models/mental_health_model.pkl
!app/models/interpretable_model.pkl
!app/models/mlb.pkl

# Streamlit runtime artifacts (machine id, credentials — never commit).
.streamlit/secrets.toml
.streamlit/credentials.toml
